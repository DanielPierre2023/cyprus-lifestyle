# ─── Cyprus Lifestyle — environment ───────────────────────────────────────────
# Copy to .env.local for local dev; set the same keys in Vercel → Project → Settings
# → Environment Variables for production. NEVER commit real keys.

# Supabase (Project → Settings → API)
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # server-only, never exposed to the browser

# AI providers (the newsroom desk) — set at least CLAUDE_API_KEY
CLAUDE_API_KEY=sk-ant-...
OPENAI_API_KEY=sk-...
GEMINI_API_KEY=...

# Email (Resend) — newsletter, inbox replies, sponsor rate cards
RESEND_API_KEY=re_...
EMAIL_FROM="Cyprus Lifestyle <newsroom@cypruslifestyle.com>"

# Cover images (Unsplash Access Key)
UNSPLASH_ACCESS_KEY=...

# Secures the Vercel Cron endpoints (any long random string). Vercel sends it as a
# Bearer token; the cron routes reject requests without it.
CRON_SECRET=generate-a-long-random-string

# Public site URL (used for absolute links in emails, sitemaps, social)
NEXT_PUBLIC_SITE_URL=https://cypruslifestyle.com

# Optional social publishing tokens (Stage 4) — leave blank to disable a channel
META_PAGE_ACCESS_TOKEN=
META_PAGE_ID=
META_IG_USER_ID=
YOUTUBE_API_KEY=
X_API_KEY=
X_API_SECRET=
X_ACCESS_TOKEN=
X_ACCESS_SECRET=
LINKEDIN_ACCESS_TOKEN=
LINKEDIN_ORG_URN=

# On-demand ISR revalidation (Supabase webhook -> /api/revalidate)
REVALIDATE_SECRET=

# Rate limiting (optional — falls back to in-memory if unset)
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Error monitoring (optional — reporting is a no-op if unset)
NEXT_PUBLIC_SENTRY_DSN=

# ── Phase 0 security & cost controls ─────────────────────────────────────────────────
# Shared secret for maintenance/job routes (/api/concierge/embed*, publish-directory,
# normalize-directory, geocode-directory, selftest, /api/editorial/*) and the Supabase
# edge functions enrich-directory / events-ingest. Send it in the `x-enrich-key` header —
# or just open the route while signed in to /admin. ROTATE the old value: it was committed.
ENRICH_SECRET=
# Set to 1 once every caller uses the header: stops accepting the secret in the URL (?key=).
ENRICH_DISABLE_QUERY_KEY=

# WhatsApp: Meta → App settings → Basic → App secret. REQUIRED, or the webhook refuses all POSTs.
WHATSAPP_APP_SECRET=
# Telegram: the same value you pass as secret_token to setWebhook. REQUIRED, or the webhook refuses all POSTs.
TELEGRAM_SECRET_TOKEN=

# AI spend protection (USD, UTC day / month; 0 = no cap). Defaults: 40 / 400.
AI_DAILY_BUDGET_USD=
AI_MONTHLY_BUDGET_USD=
# Emergency stop: 1 refuses every guarded model call at once.
AI_KILL_SWITCH=
# Global daily ceilings for the anonymous concierge (calls/day, all visitors). Defaults: 6000 chat / 600 voice.
AI_PUBLIC_DAILY_CALLS=
AI_PUBLIC_DAILY_TTS=

# ── Phase 1 · Friday newsletter ──────────────────────────────────────────────────────
# Signs the personal unsubscribe link in every newsletter e-mail (any long random string). If empty, CRON_SECRET is
# used; if both are empty the newsletter is NOT sent at all (an unsubscribe link is mandatory).
NEWSLETTER_UNSUB_SECRET=
# Who gets the "drafts are ready for approval" e-mail on Friday mornings (optional; the admin page shows it anyway).
NEWSLETTER_APPROVER_EMAIL=
